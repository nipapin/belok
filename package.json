{
  "name": "belok-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "push:keys": "tsx scripts/generate-vapid-keys.ts",
    "deploy": "git push origin master",
    "test:smoke": "node scripts/smoke-puppeteer.mjs",
    "test:checkout": "node scripts/test-checkout-api.mjs",
    "test:checkout:browser": "node scripts/test-checkout-browser.mjs",
    "aqsi:worker": "node --conditions=react-server --import tsx scripts/aqsi-worker.ts",
    "test:aqsi": "node --import tsx --test scripts/test-aqsi.mts",
    "test:aqsi:integration": "node --conditions=react-server --import tsx --test scripts/test-aqsi-integration.mts",
    "test:kiosk-control": "node --import tsx --test scripts/test-kiosk-control.mts",
    "test:manager": "node --import tsx --test scripts/test-manager-workspace.mts",
    "test:manager:integration": "node --import tsx --test scripts/test-manager-workspace-integration.mts",
    "test:employees": "node --import tsx --test scripts/test-employees.mts",
    "test:inventory": "node --import tsx --test scripts/test-inventory-stock.mts",
    "test:inventory:integration": "node --import tsx --test scripts/test-inventory-operations.mts",
    "test:inventory:metadata": "node --import tsx --test scripts/test-inventory-metadata.mts",
    "deploy:manual": "git pull && npm ci --no-fund --no-audit && npm run build && pm2 startOrReload ecosystem.config.js --only belok --update-env && pm2 save",
    "test:revenue:browser": "node scripts/test-revenue-browser.mjs",
    "test:revenue:hourly": "node scripts/test-revenue-hourly-browser.mjs",
    "test:revenue": "node --import tsx --test scripts/test-admin-dashboard.mts scripts/test-revenue-stats.mts scripts/test-dish-sales.mts",
    "test:roles": "node --import tsx --test scripts/test-roles.mts scripts/test-admin-update.mts",
    "test:weather": "node --import tsx --test scripts/test-weather.mts scripts/test-weather-server.mts",
    "weather:sync": "node --import tsx scripts/sync-weather.ts",
    "test:products-v2": "node --import tsx --test scripts/test-products-v2.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.544.0",
    "mapbox-gl": "^3.31.0",
    "next": "^16.3.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-imask": "^7.6.1",
    "resend": "^6.12.3",
    "sharp": "^0.35.3",
    "uuid": "^13.0.2",
    "web-push": "^3.6.7",
    "webpack": "^5.106.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "puppeteer": "^25.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true,
    "puppeteer@25.10.0": true,
    "core-js-pure": false
  }
}
